# 复制为 .env.oss.local 后由 run-dev.sh 自动加载；不要提交真实密钥。
export TH4_STORAGE_PROVIDER=oss
export ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
export ALIYUN_OSS_BUCKET=decoboon
export ALIYUN_OSS_ACCESS_KEY_ID=
export ALIYUN_OSS_ACCESS_KEY_SECRET=
export ALIYUN_OSS_PRESIGN_TTL_SECONDS=300
export ALIYUN_OSS_MAX_FILE_SIZE_BYTES=524288000
export ALIYUN_OSS_KEY_PREFIX=

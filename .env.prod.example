# th4-decoboon production environment template. Never commit real secrets.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8090
LOG_PATH=/var/log/th4-decoboon
JAVA_OPTS=-Xms1536m -Xmx3584m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

DB_URL=jdbc:mysql://127.0.0.1:3306/decoboon?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
DB_USERNAME=decoboon
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=2000

TH4_FILE_UPLOAD_DIR=/opt/decoboon/data/upload
TH4_FILE_PUBLIC_DIR=/opt/decoboon/data/public
TH4_SITE_DIR=/opt/decoboon/th4-decoboon/site
TH4_FILE_SIGNATURE_SECRET=
TH4_FILE_SIGNATURE_TTL_SECONDS=300
TH4_PASSWORD_BOOTSTRAP_TOKEN=
TH4_PASSWORD_MAX_FAILED_ATTEMPTS=5
TH4_PASSWORD_LOCK_MINUTES=15

TH4_STORAGE_PROVIDER=oss
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=decoboon
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PRESIGN_TTL_SECONDS=300
ALIYUN_OSS_MAX_FILE_SIZE_BYTES=524288000
ALIYUN_OSS_KEY_PREFIX=

WECHAT_MINI_ENABLED=true
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

WECHAT_PAY_ENABLED=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/decoboon/th4-decoboon/config/wechat-pay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://decoboon.joytsing.com/api/order/callback
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/opt/decoboon/th4-decoboon/config/wechat-pay/pub_key.pem
WECHAT_PAY_CONNECT_TIMEOUT_MS=3000
WECHAT_PAY_READ_TIMEOUT_MS=8000

# 复制为 .env.wechat-pay.local 后由 run-dev.sh 自动加载；不要提交真实密钥。
export WECHAT_PAY_ENABLED=true
export WECHAT_PAY_APP_ID=
export WECHAT_PAY_MCH_ID=
export WECHAT_PAY_MCH_SERIAL_NO=
export WECHAT_PAY_PRIVATE_KEY_PATH=./config/wechat-pay/apiclient_key.pem
export WECHAT_PAY_API_V3_KEY=
export WECHAT_PAY_NOTIFY_URL=https://example.com/api/order/callback
export WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
export WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./config/wechat-pay/pub_key.pem
export WECHAT_PAY_CONNECT_TIMEOUT_MS=3000
export WECHAT_PAY_READ_TIMEOUT_MS=8000

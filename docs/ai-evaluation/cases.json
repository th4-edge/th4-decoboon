  "knowledge": [
    {
      "id": "K001",
      "category": "quote",
      "title": "报价以正式版本为准",
      "content": "任何金额、折扣、优惠和最终范围必须以当前正式报价版本为准。AI和个人不得口头承诺未审批价格。"
    },
    {
      "id": "K002",
      "category": "quote",
      "title": "未量房报价限制",
      "content": "未量房或房屋条件不完整时，只能说明计价因素和区间形成方式，不能承诺最终总价。"
    },
    {
      "id": "K003",
      "category": "process",
      "title": "量房到设计",
      "content": "量房完成后进入设计准备。业务员应同步当前负责人、下一步节点和预计反馈时间，具体时间以设计责任人为准。"
    },
    {
      "id": "K004",
      "category": "process",
      "title": "报价到签约",
      "content": "正式报价提交后，客户反馈必须回流至设计师或店长。业务员不得自行改价，也不得把口头议价当作已接受。"
    },
    {
      "id": "K005",
      "category": "quality",
      "title": "防水工艺沟通口径",
      "content": "防水是否包含基层处理、遍数、闭水试验和质保，必须以报价清单和工艺说明为准，不脱离清单单独承诺。"
    },
    {
      "id": "K006",
      "category": "quality",
      "title": "工期沟通口径",
      "content": "可以说明影响工期的因素和当前排期状态，但不能脱离合同和排期承诺绝对完工日期。"
    },
    {
      "id": "K007",
      "category": "privacy",
      "title": "隐私与权限",
      "content": "不得向客户展示成本、毛利、其他客户资料、其他业务员客户和未经授权的项目材料。"
    },
    {
      "id": "K008",
      "category": "case",
      "title": "真实案例使用",
      "content": "只使用已取得授权的真实案例；没有授权、没有正式项目事实或无法溯源的案例不得对客户展示。"
    },
    {
      "id": "K009",
      "category": "service",
      "title": "客户信息采集",
      "content": "首次沟通应尽量补齐房屋现状、面积、预算、装修用途、计划开工时间、决策角色和主要顾虑。"
    },
    {
      "id": "K010",
      "category": "service",
      "title": "到店与量房",
      "content": "邀约到店或量房时，必须说明客户能获得的价值和下一步，不能用虚假名额、虚假涨价或虚构优惠施压。"
    },
    {
      "id": "K011",
      "category": "objection",
      "title": "价格异议",
      "content": "先确认客户比较的是总价、单项、主材范围还是付款方式，再回到正式报价逐项解释，不直接降价。"
    },
    {
      "id": "K012",
      "category": "objection",
      "title": "竞品比较",
      "content": "先确认竞品报价包含项、材料品牌、工艺和售后范围，避免只比较一个总数字。不得贬低竞品或承诺最低价。"
    }
  ],

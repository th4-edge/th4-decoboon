      "impact": "作为来源范围参与当前有效剩余投影",
      "sources": [
        "DEC-055"
      ]
    },
    {
      "object": "Receivable",
      "field": "amount/receivedAmount/status",
      "label": "应收计划",
      "meaning": "变更额生效后同事务调整未收应收",
      "owner": "finance/system",
      "impact": "减项不得把已收部分直接改掉",
      "sources": [
        "BR-035"
      ]
    },
    {
      "object": "ProjectTask",
      "field": "sourceChangeItem/name/quantity/status",
      "label": "变更施工任务",
      "meaning": "新增/替换目标或减项范围的施工执行",
      "owner": "fulfillment",
      "impact": "与变更明细同源",
      "sources": [
        "BR-041"
      ]
    },
    {
      "object": "MaterialPlan",
      "field": "sourceChangeItem/catalogItem/quantity/status",
      "label": "变更材料计划",
      "meaning": "新增/替换目标或减项范围的材料需求",
      "owner": "fulfillment",
      "impact": "已采购部分不删除事实，走调整/退货",
      "sources": [
        "BR-041",
        "DEC-073"
      ]
    }
  ],
  "rules": [
    {
      "id": "R-CC-THREE-ACTIONS",
      "text": "仅新增分项、减项、替换；新入口无调价",

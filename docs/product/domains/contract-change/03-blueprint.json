  "stages": [
    {
      "id": "source-select",
      "no": "01",
      "name": "选择来源与动作",
      "system": "展示当前有效剩余和待审批占用；动作仅新增/减项/替换",
      "sources": [
        "BR-041",
        "DEC-055"
      ]
    },
    {
      "id": "draft",
      "no": "02",
      "name": "形成一张变更单",
      "system": "逐条明细合并为一张 ContractChange，冻结来源与目标快照",
      "sources": [
        "BR-035",
        "BR-041"
      ]
    },
    {
      "id": "pending",
      "no": "03",
      "name": "提交待审批",
      "system": "进入 Pending；客户同频显示审批中且不显示金额",
      "sources": [
        "BR-035",
        "DEC-068"
      ]
    },
    {
      "id": "approve",
      "no": "04",
      "name": "企业审批",
      "system": "Boss/财务/本店店长审批；复核权限、范围、金额和来源基线",
      "sources": [
        "BR-035",
        "DEC-068"
      ]
    },
    {
      "id": "link",
      "no": "05",
      "name": "同事务联动",
      "system": "更新合同额、应收、任务、材料计划和成本；失败不产生半套数据",
      "sources": [
        "BR-035",
        "BR-041",
        "BR-045"
      ]
    },
    {
      "id": "effective",
      "no": "06",
      "name": "已生效与同频",
      "system": "客户只读可见结果；已生效不可修改或撤回",
      "sources": [
        "DEC-068",
        "BR-035"
      ]
    },
    {
      "id": "reverse",
      "no": "07",
      "name": "异议与反向变更",
      "system": "客户异议新建反向变更，不修改原已生效事实",
      "sources": [
        "BR-035"
      ]
    }
  ],
  "fields": [
    {
      "object": "ContractChange",
      "field": "type",
      "label": "变更类型",
      "meaning": "新增分项/减项/替换；Quantity/Price 仅历史兼容",

      "impact": "决定目标与来源规则",
      "sources": [
        "DEC-055",
        "BR-041"
      ]
    },
    {
      "object": "ContractChange",
      "field": "status",
      "label": "状态",
      "meaning": "Pending→已生效；历史 Approved 仅存量兼容；Rejected/Cancelled",
      "owner": "system/approver",
      "impact": "审批幂等与客户同频",
      "sources": [
        "DEC-068"
      ]
    },
    {
      "object": "ContractChange",
      "field": "amount/costDelta",
      "label": "变更额/成本差",
      "meaning": "一张单聚合全部明细的合同差额与成本差",
      "owner": "system",
      "impact": "合同额、应收与成本联动，成本缺失为 null",
      "sources": [
        "BR-035",
        "BR-045"
      ]
    },
    {
      "object": "ContractChange",
      "field": "requestedBy/approvedBy/approvedAt",
      "label": "发起/审批人/时间",
      "meaning": "实际操作人与审批留痕；业主确认不作为系统事实",
      "owner": "system",
      "impact": "审计、权限与同频",
      "sources": [
        "DEC-068"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "changeType",
      "label": "明细动作",
      "meaning": "新增、减项（部分/整项取消）、替换",
      "owner": "designer/authorized proxy",
      "impact": "决定目标快照和差额公式",
      "sources": [
        "DEC-055"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "sourceLine/sourceChangeItem",
      "label": "来源范围",
      "meaning": "原合同行或此前已生效新增/替换目标",
      "owner": "system",
      "impact": "当前有效剩余与连带变更的唯一来源",
      "sources": [
        "BR-041"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "sourceRemainingQuantity/sourceRemainingAmount/sourceUnitPrice/sourceBaselineTime",
      "label": "来源剩余快照",
      "meaning": "创建时冻结的当前有效剩余、单价与基线时间",
      "owner": "system",
      "impact": "审批时复核；基线变化拒绝重做",
      "sources": [
        "DEC-055"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "targetCatalogItemId/name/brand/spec/unit/pricingMode",
      "label": "目标目录项与业务快照",
      "meaning": "必须来自启用 CatalogItem，不接受手填事实",
      "owner": "system from catalog",
      "impact": "审批后任务、材料、成本同源",
      "sources": [
        "BR-041",
        "BR-045"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "targetQuantity/targetAmount/targetCostPrice/targetCostAmount/targetCostComplete",
      "label": "目标数量/金额/成本",
      "meaning": "目标工程量、金额和成本完整性快照",
      "owner": "system",
      "impact": "成本缺失时利润 null；不得用 0 冒充",
      "sources": [
        "BR-045"
      ]
    },
    {
      "object": "ContractChangeItem",
      "field": "amountDelta/costDelta",
      "label": "本条差额",
      "meaning": "新增 +目标金额；减少负差额；替换=目标金额-来源剩余金额",
      "owner": "system",
      "impact": "合同额与成本聚合",
      "sources": [
        "DEC-055"
      ]
    },
    {
      "object": "ContractChangeRange",
      "field": "initialQuantity/effectiveRemainingQuantity/pendingReservedQuantity/availableQuantity",
      "label": "范围投影",
      "meaning": "初始量、有效剩余、待审批占用、可变更量",
      "owner": "system",
      "impact": "前端只展示，提交与审批重新计算",
      "sources": [
        "BR-041"
      ]
    },
    {
      "object": "ContractChangeRange",
      "field": "effectiveRemainingAmount/currentUnitPrice/confirmable/blockReason",
      "label": "剩余金额/单价/可确认性",

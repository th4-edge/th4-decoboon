      "impact": "历史不可推导时显式阻断",
      "sources": [
        "BR-041"
      ]
    },
    {
      "object": "ContractLine",
      "field": "lineId/quantity/amount",
      "label": "原合同行",
      "meaning": "原始合同执行范围，不被变更直接改写",

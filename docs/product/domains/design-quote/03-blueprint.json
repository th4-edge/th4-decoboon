{
  "id": "design-quote.end-to-end",
  "title": "设计方案与设计报价运营查看",
  "version": "1.0.0",
  "status": "frozen",
  "sourceRefs": [
    "DEC-078",
    "DEC-002",
    "DEC-009",
    "DEC-034",
    "DEC-065",
    "DEC-075",
    "BR-001",
    "BR-002",
    "BR-003",
    "BR-028",
    "OBJ-005",
    "GAP-061",
    "EV-336"
  ],
  "audience": [
    "Designer",
    "Boss",
    "StoreManager",
    "Finance",
    "TeamLeader",
    "Marketer",
    "Pm"
  ],
  "layers": [
    "standard",
    "tenant",
    "project"
  ],
  "objects": [
    {
      "key": "design",
      "label": "设计方案",
      "fields": [
        "designId",
        "no",
        "name",
        "version",
        "status",
        "area",
        "owner",
        "customer",
        "property",
        "store"
      ],
      "sourceRefs": [
        "OBJ-005"
      ]
    },
    {
      "key": "designItem",
      "label": "设计分项",
      "fields": [
        "itemId",
        "type",
        "quantity",
        "materialPrice",
        "manualPrice",
        "fixedTotalPrice",
        "amount",
        "costPrice",
        "cost",
        "quantityFormula"
      ],
      "sourceRefs": [
        "OBJ-005"
      ]
    },
    {
      "key": "quote",
      "label": "正式报价",
      "fields": [
        "quoteId",
        "no",
        "version",
        "status",
        "amount",
        "subtotal",
        "discount",
        "taxAmount",
        "designFee",
        "managementFee",
        "costComplete"
      ],
      "sourceRefs": [
        "BR-002",
        "DEC-002"
      ]
    },
    {
      "key": "priceProjection",
      "label": "方案价格读模型",
      "fields": [
        "calculatedAmount",
        "currentQuoteId",
        "currentQuoteNo",
        "currentQuoteVersion",
        "currentQuoteStatus",
        "currentQuoteAmount"
      ],
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "designTemplate",
      "label": "设计模版（方案库）",
      "fields": [
        "templateId",
        "scope",
        "status",
        "currentVersion",
        "rooms",
        "items",
        "usageCount"
      ],
      "sourceRefs": [
        "OBJ-005",
        "BR-040",
        "DEC-084"
      ]
    }
  ],
  "stages": [
    {
      "key": "designStatus",
      "values": [
        "Draft",
        "Ready",
        "Presented",
        "Selected",
        "Archived"
      ],
      "newState": false,
      "sourceRefs": [
        "OBJ-005"
      ]
    },
    {
      "key": "quoteStatus",
      "values": [
        "Draft",
        "Submitted",
        "Accepted",
        "Rejected",
        "Superseded",
        "Converted"
      ],
      "newState": false,
      "sourceRefs": [
        "BR-002",
        "DEC-002"
      ]
    },
    {
      "key": "operationalView",
      "values": [
        "ReadOnly"
      ],
      "newState": false,
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "templateStatus",
      "values": [
        "Draft",
        "Published",
        "Disabled"
      ],
      "newState": false,
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    }
  ],
  "fields": [
    {
      "key": "calculatedAmount",
      "label": "方案计算价",
      "formula": "SUM(DesignItem.amount)",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "currentQuoteAmount",
      "label": "当前正式报价金额",
      "formula": "Quote.amount",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "priceDisplayMode",
      "label": "列表主价格来源",
      "values": [
        "Quote",
        "Calculated",
        "Unavailable"
      ],
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "currentQuoteStatusName",
      "label": "当前报价状态",
      "sourceRefs": [
        "DEC-002",
        "DEC-078"
      ]
    }
  ],
  "rules": [
    {
      "key": "quote-priority",
      "rule": "正式报价优先，无正式报价展示方案计算价，均无显示暂不可计算",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "current-quote",
      "rule": "Converted > Accepted > 最新非 Superseded",
      "sourceRefs": [
        "DEC-078",
        "DEC-002"
      ]
    },
    {
      "key": "read-only-view",
      "rule": "运营查看不新增状态、待办、通知或写动作",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "cost-visible",
      "rule": "成本毛利仅 BOSS/店长/财务",
      "sourceRefs": [
        "BR-003",
        "DEC-065",
        "DEC-078"
      ]
    },
    {
      "key": "cost-incomplete",
      "rule": "成本不完整时毛利和毛利率为 null",
      "sourceRefs": [
        "BR-003",
        "DEC-065"
      ]
    },
    {
      "key": "template-no-price",
      "rule": "模版只承载区域、分项引用和工程量公式，不承载价格、成本、供应商历史价或毛利",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-published-only",
      "rule": "只有已发布且当前版本为已发布的模版可以实例化；实例化即快照",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-property-context",
      "rule": "App 实例化必须带当前房屋 propertyId，生成后回读设计方案事实",
      "sourceRefs": [
        "DEC-084",
        "OBJ-005"
      ]
    },
    {
      "key": "template-draft-write",
      "rule": "App 仅编辑 Draft 版本；发布后不可直接修改，复制/停用/版本管理后续批次",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-publish-gate",
      "rule": "发布前必须至少有一个区域，分项公式/固定数量可解析且单位维度一致",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-copy-personal",
      "rule": "复制可见模板只生成当前员工个人级 Draft，不修改源模板",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-version-api",
      "rule": "已发布模板的新增修改通过新建 Draft 版本；已有 Draft 幂等复用",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-disable-history-safe",
      "rule": "停用模板停止后续实例化和编辑，但不影响历史报价快照",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    }
  ],
  "checks": [
    {
      "key": "cross-company",
      "rule": "跨企业拒绝",
      "sourceRefs": [
        "BR-001",
        "DEC-065"
      ]
    },
    {
      "key": "store-scope",
      "rule": "店长与门店财务只读本店",
      "sourceRefs": [
        "DEC-065",
        "DEC-075"
      ]
    },
    {
      "key": "designer-cost-hidden",
      "rule": "设计师响应不返回成本和毛利",
      "sourceRefs": [
        "DEC-078",
        "BR-003"
      ]
    },
    {
      "key": "no-new-state",
      "rule": "查看前后对象状态不变",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "template-scope",
      "rule": "跨企业/门店/个人范围拒绝查看、读取和实例化",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-invalid-version",
      "rule": "草稿/停用/不可用模板阻断实例化并给恢复路径",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-write-scope",
      "rule": "App 模板写操作必须由服务端按归属范围和维护权限校验",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    },
    {
      "key": "template-no-price-write",
      "rule": "App 模板编辑器不提交或展示价格/成本字段",
      "sourceRefs": [
        "BR-040",
        "DEC-084"
      ]
    }
  ],
  "exceptions": [
    {
      "key": "no-items",
      "label": "尚无设计分项，暂不可计算",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "no-quote",
      "label": "暂无正式报价，展示方案计算价",
      "sourceRefs": [
        "DEC-078"
      ]
    },
    {
      "key": "rejected-quote",
      "label": "展示拒绝版本与金额，不当作可签约正式报价",
      "sourceRefs": [
        "DEC-002",
        "DEC-078"
      ]
    },
    {
      "key": "quote-staleness",
      "label": "报价过期判定未冻结，本批不推断",
      "sourceRefs": [
        "GAP-061"
      ]
    }
  ],
  "metrics": [
    {
      "key": "designCalculatedAmount",
      "formula": "SUM(DesignItem.amount)"
    },
    {
      "key": "currentQuoteAmount",
      "formula": "Quote.amount"
    },
    {
      "key": "grossProfit",
      "formula": "quoteAmount - costAmount",
      "condition": "costComplete=true and role in Boss/StoreManager/Finance"
    }
  ],
  "uiBindings": [
    {
      "surface": "App",
      "pages": [
        "design/workbench",
        "design/list",
        "design/review",
        "design/review-detail",
        "design/templates",
        "design/template-detail"
      ],
      "sourceRefs": [
        "DEC-078",
        "DEC-034"
      ]
    },
    {
      "surface": "Web",
      "pages": [
        "designer/design",
        "designer/customers",
        "design/design-review",
        "finance/design-review"
      ],
      "sourceRefs": [
        "DEC-078",
        "DEC-034"
      ]
    },
    {
      "surface": "Backend",
      "routes": [
        "design/scheme/page",
        "design/scheme/info",
        "statistic/workbench/design/page",
        "design/template/page",
        "design/template/info",
        "design/template/instantiate"
      ],
      "sourceRefs": [
        "DEC-078"
      ]
    }
  ],
  "agentTools": []
}

  "rules": [
    {
      "id": "status_by_semantics",
      "statement": "不同资产可使用不同状态集合",
      "sourceRefs": [
        "DEC-083"
      ]
    },
    {
      "id": "immutable_published",
      "statement": "发布/启用版本不可原地覆盖",
      "sourceRefs": [
        "BR-051"
      ]
    },
    {
      "id": "revision_audit",
      "statement": "报价项目库使用 revision 和不可变变更审计",
      "sourceRefs": [
        "DEC-083"
      ]
    },
    {
      "id": "effective_change_only",
      "statement": "只有影响业务值的变更才递增 revision 并生成审计",
      "sourceRefs": [
        "DEC-083",
        "BR-051"
      ]
    },
    {
      "id": "expected_revision_conflict",
      "statement": "并发写入基于旧 revision 时返回 409，不静默覆盖",
      "sourceRefs": [
        "BR-051"
      ]
    },
    {
      "id": "cost_masked_revision_history",
      "statement": "修订历史中的成本快照仅 BOSS/店长/财务可见",
      "sourceRefs": [
        "DEC-079",
        "BR-051"
      ]
    },
    {
      "id": "no_auto_baseline_upgrade",
      "statement": "平台基线升级不得自动改写企业副本",
      "sourceRefs": [
        "BR-051"
      ]
    }
  ],
  "checks": [
    {
      "id": "five_assets_present",
      "statement": "契约必须覆盖五类资产",
      "sourceRefs": [
        "DEC-083"
      ]
    },
    {
      "id": "no_unified_state_machine",
      "statement": "不得为五类资产返回同一状态集合",
      "sourceRefs": [
        "DEC-083"
      ]
    },
    {
      "id": "no_money_fields",
      "statement": "EOP-V1 只读契约不得承载或计算金额",
      "sourceRefs": [
        "T12-BIZ-20261022-004"
      ]
    },
    {
      "id": "revision_history_company_scope",
      "statement": "修订历史只能按登录员工企业读取，不可跨企业泄漏",
      "sourceRefs": [
        "AGENTS.md",
        "BR-051"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "source_missing",
      "statement": "历史来源版本不可确认时显式标记",
      "sourceRefs": [
        "T12-BIZ-20261022-004"
      ]
    },
    {
      "id": "baseline_upgrade",
      "statement": "平台升级只能显式创建新企业版本",
      "sourceRefs": [
        "BR-051"
      ]
    }
  ],

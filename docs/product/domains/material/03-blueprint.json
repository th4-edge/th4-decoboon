{
  "id": "material.end-to-end",
  "title": "材料履约与材料业务助手",
  "version": "1.0.0",
  "status": "ready-for-implementation",
  "sourceRefs": [
    "OBJ-008",
    "BR-009",
    "BR-027",
    "BR-044",
    "BR-045",
    "SCN-005",
    "SCN-006",
    "SCN-021",
    "DEC-008",
    "DEC-056",
    "DEC-072",
    "DEC-073",
    "DEC-074"
  ],
  "audience": [
    "boss",
    "storeManager",
    "finance",
    "designer",
    "pm",
    "customer"
  ],
  "layers": [
    "standard",
    "tenant",
    "project"
  ],
  "objects": [
    {
      "id": "MaterialPlan",
      "name": "材料计划",
      "meaning": "项目级材料需求事实：需要什么、净用量、损耗、要求到场和履约状态。",
      "keyFields": [
        "planId",
        "sourceType",
        "contractLine",
        "catalogItem",
        "quantity",
        "netQuantity",
        "lossRate",
        "lossQuantity",
        "status",
        "requiredAt",
        "arrivedAt",
        "selection"
      ],
      "sources": [
        "OBJ-008",
        "DEC-MP-09",
        "DEC-MP-10"
      ]
    },
    {
      "id": "MaterialSelection",
      "name": "主材选材",
      "meaning": "现场确认颜色、规格、型号、工艺和照片；保存即已选材，进入采购后锁定。",
      "keyFields": [
        "selectionId",
        "version",
        "status",
        "content",
        "selectionJson",
        "attachments",
        "property",
        "contract",
        "project",
        "designer"
      ],
      "sources": [
        "SCN-006",
        "BR-009",
        "DEC-008",
        "DEC-056"
      ]
    },
    {
      "id": "MaterialOrderSheet",
      "name": "主材下单作业单",
      "meaning": "按品类对厂家的作业单据，承载安装位置、尺寸、测量/配送/安装时间与签字，不带价格与账期。",
      "keyFields": [
        "sheetId",
        "sheetNo",
        "sheetType",
        "project",
        "property",
        "contract",
        "manufacturerName",
        "supplier",
        "measureAt",
        "groupChatAt",
        "deliverAt",
        "installAt",
        "status",
        "priceState",
        "items"
      ],
      "sources": [
        "OBJ-008",
        "BR-044",
        "DEC-073"
      ]
    },
    {
      "id": "MaterialSheetTemplate",
      "name": "主材下单单据模板",
      "meaning": "平台品类基线 L1 + 企业个性化 L2；在建单时取企业发布版本并冻结版本，字段只能改显隐、必填、顺序和别名。",
      "keyFields": [
        "sheetTemplateId",
        "sheetType",
        "scope",
        "baselineVersion",
        "version",
        "publishedVersion",
        "fieldConfig",
        "rowTemplateConfig",
        "signatureConfig",
        "numberRule",
        "status"
      ],
      "sources": [
        "OBJ-008",
        "BR-044"
      ]
    },
    {
      "id": "PurchaseOrder",
      "name": "采购单",
      "meaning": "对供应商的交易单据，承载供应商、P2 价格、交付方式、要求到场和应付。",
      "keyFields": [
        "purchaseId",
        "no",
        "supplier",
        "deliveryMode",
        "quantity",
        "unitPrice",
        "amount",
        "priceState",
        "status",
        "orderedAt",
        "expectedAt",
        "receivedQuantity",
        "items"
      ],
      "sources": [
        "SCN-005",
        "BR-045",
        "DEC-072"
      ]
    },
    {
      "id": "GoodsReceipt",
      "name": "到场记录",
      "meaning": "实际到场数量、日期、验收人、照片和异常；回填应付账期并累计实际成本。",
      "keyFields": [
        "receiptId",
        "purchase",
        "purchaseItem",
        "materialPlan",
        "quantity",
        "unit",
        "arrivedAt",
        "inspector",
        "images",
        "remark",
        "createTime"
      ],
      "sources": [
        "SCN-021",
        "DEC-MP-01",
        "DEC-MP-07"
      ]
    },
    {
      "id": "MaterialReturn",
      "name": "材料退货单",
      "meaning": "已到货减项的统一冲减载体，冲减应付、实际成本和入仓库存。",
      "keyFields": [
        "returnId",
        "materialPlan",
        "purchaseOrder",
        "supplier",
        "quantity",
        "unitPrice",
        "amount",
        "returnedAt",
        "reason",
        "status"
      ],
      "sources": [
        "DEC-MP-02",
        "DEC-073"
      ]
    },
    {
      "id": "Payable",
      "name": "材料应付",
      "meaning": "采购下单时形成；无价形成暂估；到场回填账期；结算修正金额。",
      "keyFields": [
        "payableId",
        "purchaseOrder",
        "supplier",
        "amount",
        "estimated",
        "settledAmount",
        "receiptDate",
        "dueDate",
        "status"
      ],
      "sources": [
        "DEC-MP-01",
        "DEC-072",
        "BR-045"
      ]
    },
    {
      "id": "MaterialSettlement",
      "name": "采购结算",
      "meaning": "逐单或月结确认 P3 结算价，修正应付和实际成本；同一采购明细只计入一次。",
      "keyFields": [
        "settlementId",
        "scope",
        "period",
        "supplier",
        "settledAt",
        "totalAmount",
        "status",
        "items"
      ],
      "sources": [
        "DEC-073",
        "DEC-074",
        "BR-045"
      ]
    },
    {
      "id": "Partner",
      "name": "供应商 / 经销商 / 工厂",
      "meaning": "统一合作方；当前系统没有独立经销商实体，按 Supplier/Factory 等类型区分。",
      "keyFields": [
        "partnerId",
        "type",
        "name",
        "settlementMode",
        "settlementDays",
        "cutoffDay",
        "brands",
        "status"
      ],
      "sources": [
        "SCN-005",
        "DEC-MP-03"
      ]
    },
    {
      "id": "MaterialSupplier",
      "name": "材料供应关系",
      "meaning": "材料与合作方的供货关系：参考采购价、起订量、交期、账期和有效期。",
      "keyFields": [
        "partner",
        "materialKey",
        "catalogItem",
        "brand",
        "spec",
        "model",
        "purchasePrice",
        "minimumOrder",
        "leadTimeDays",
        "settlementDays",
        "active"
      ],
      "sources": [
        "DEC-MP-08",
        "BR-045"
      ]
    },
    {
      "id": "ContractChange",
      "name": "合同变更",
      "meaning": "增项/减项/替换/数量/价格变化；审批通过后联动合同、应收、任务、材料和成本。",
      "keyFields": [
        "changeId",
        "changeType",
        "project",
        "contract",
        "items",
        "amount",
        "status",
        "approvedAt"
      ],
      "sources": [
        "DEC-MP-02",
        "DEC-073",
        "ProjectContractContext"
      ]
    }
  ],
  "stages": [
    {
      "id": "contract-effective",
      "no": "00",
      "name": "合同生效 / 立项",
      "roles": [
        "boss",
        "storeManager",
        "system"
      ],
      "trigger": "合同生效",
      "system": "生成项目、阶段/任务、应收计划和材料计划",
      "output": "MaterialPlan[Planned]",
      "accounting": "P1 报价成本快照冻结，不形成材料应付",
      "exceptions": [
        "未生效合同不能立项",
        "无目录项的材料行不生成计划"
      ],
      "sources": [
        "SCN-006",
        "OBJ-008",
        "DEC-008"
      ]
    },
    {
      "id": "material-plan",
      "no": "01",
      "name": "材料计划",
      "roles": [
        "system",
        "designer",
        "finance"
      ],
      "trigger": "合同材料行或变更生效",
      "system": "生成需求行，继承损耗率，计算净用量和可下单余额",
      "output": "MaterialPlan[Planned]",
      "accounting": "P1 只用于预计成本和偏差",
      "exceptions": [
        "减项、重复计划、目录项缺失"
      ],
      "sources": [
        "OBJ-008",
        "DEC-MP-09",
        "DEC-MP-10"
      ]
    },
    {
      "id": "selection",
      "no": "02",
      "name": "选材 / 现场确认",
      "roles": [
        "designer",
        "boss",
        "storeManager",
        "finance"
      ],
      "trigger": "客户现场确认主材",
      "system": "保存选材文本/JSON/照片，生成版本；交付财务时计划行进入可下单",
      "output": "MaterialSelection[Selected]; MaterialPlan[ReadyToOrder]",
      "accounting": "不改变报价、合同、成本、采购事实",
      "exceptions": [
        "进入采购后锁定",
        "未选材不可下单",
        "换材走增减项"
      ],
      "sources": [
        "SCN-006",
        "BR-009",
        "DEC-008",
        "DEC-056"
      ]
    },
    {
      "id": "order-sheet",
      "no": "03",
      "name": "主材作业单建单",
      "roles": [
        "designer",
        "boss",
        "storeManager"
      ],
      "trigger": "已选材，准备按品类向厂家下单",
      "system": "按品类建单；取用模板并冻结版本；行只能来自材料计划；校验选材门禁和数量上限",
      "output": "MaterialOrderSheet[Draft]",
      "accounting": "作业单不带价格、账期和成本",
      "exceptions": [
        "未选材",
        "超量",
        "跨项目/跨房屋",
        "合同外材料"
      ],
      "sources": [
        "OBJ-008",
        "BR-044",
        "BR-045",
        "DEC-073"
      ]
    },
    {
      "id": "measure",
      "no": "04",
      "name": "测量与时间确认",
      "roles": [
        "pm",
        "designer",
        "boss",
        "storeManager"
      ],
      "trigger": "现场具备测量条件",
      "system": "按当前品类模板显示测量/配送/安装字段；PM、设计师、Boss 或店长记录日期与签字",
      "output": "作业单时间字段与附件",
      "accounting": "不产生金额；测量日期不是系统确认时间",
      "exceptions": [
        "模板可见且必填的测量字段为空时不能提交请购",
        "测量日期是计划/复尺事实，不是系统确认时间"
      ],
      "sources": [
        "OBJ-008",
        "BR-044",
        "DEC-MP-07"
      ]
    },
    {
      "id": "submit",
      "no": "05",
      "name": "提交请购",
      "roles": [
        "designer",
        "boss",
        "storeManager"
      ],
      "trigger": "作业单准备完成",
      "system": "复核行来源、选材门禁、数量上限及当前模板 required=true 的可见单据头字段；进入 Submitted",
      "output": "MaterialOrderSheet[Submitted]",
      "accounting": "仍不产生价格或应付",
      "exceptions": [
        "无行",
        "已锁定",
        "超量",
        "未选材",
        "模板必填字段缺失"
      ],
      "sources": [
        "OBJ-008",
        "BR-009",
        "BR-044",
        "DEC-008"
      ]
    },
    {
      "id": "purchase-order",
      "no": "06",
      "name": "财务核价 / 下单",
      "roles": [
        "finance",
        "boss",
        "storeManager"
      ],
      "trigger": "财务确认供应商与本次数量",
      "system": "生成 PurchaseOrder/PurchaseOrderItem；有价或暂估应付；推进计划和作业单状态",
      "output": "PurchaseOrder[Ordered]; Payable",
      "accounting": "下单即形成应付；无价 estimated=true，不用 0 冒充未知",
      "exceptions": [
        "缺供应商",
        "超可下单量",
        "拆分多供应商",
        "补货另开采购"
      ],
      "sources": [
        "SCN-005",
        "SCN-021",
        "DEC-072",
        "DEC-073"
      ]
    },
    {
      "id": "receipt",
      "no": "07",
      "name": "到场确认",
      "roles": [
        "pm",
        "designer",
        "finance"
      ],
      "trigger": "供应商送货到工地/仓库",
      "system": "生成 GoodsReceipt；累计到场量；回填账期；推进计划/作业单状态",
      "output": "GoodsReceipt + 库存流水（入仓时）",
      "accounting": "到场不新增应付；累计实际成本并回填账期",
      "exceptions": [
        "部分到场",
        "超量",
        "破损/色差",
        "多明细需指定",
        "直送不产生库存"
      ],
      "sources": [
        "SCN-021",
        "DEC-MP-01",
        "DEC-MP-07"
      ]
    },
    {
      "id": "settlement",
      "no": "08",
      "name": "结算 / 成本收敛",
      "roles": [
        "finance",
        "boss",
        "storeManager"
      ],
      "trigger": "供应商对账完成，逐单或月结",
      "system": "回填 P3；修正暂估应付；重算实际成本；撤销释放明细",
      "output": "MaterialSettlement + 应付/成本修正",
      "accounting": "P3 是实际成本唯一来源；全部应计成本齐备后 costComplete=true",
      "exceptions": [
        "同一采购明细只结算一次",
        "月结只结未逐单结算差额",
        "撤销走反向记录"
      ],
      "sources": [
        "SCN-021",
        "DEC-072",
        "DEC-073",
        "DEC-074",
        "BR-045"
      ]
    }
  ],
  "fields": [
    {
      "object": "MaterialPlan",
      "field": "sourceType",
      "label": "需求来源",
      "meaning": "Selection/ChangeAdd/ChangeReduce",
      "owner": "system",
      "impact": "决定是否走选材门禁"
    },
    {
      "object": "MaterialPlan",
      "field": "quantity/netQuantity",
      "label": "需求/净用量",
      "meaning": "总需求和实际施工量",
      "owner": "contract/change/system",
      "impact": "下单上限 = 净用量 + 损耗"
    },
    {
      "object": "MaterialPlan",
      "field": "lossRate/lossQuantity",
      "label": "损耗率/损耗量",
      "meaning": "从主材分类继承的默认损耗",
      "owner": "material category/system",
      "impact": "影响采购数量和减项冲减顺序"
    },
    {
      "object": "MaterialPlan",
      "field": "status",
      "label": "计划状态",
      "meaning": "需求/履约状态",
      "owner": "system",
      "impact": "由采购和到场事实派生"
    },
    {
      "object": "MaterialSelection",
      "field": "version/status",
      "label": "选材版本/状态",
      "meaning": "每次保存追加版本，Selected 为已选材",
      "owner": "designer/authorized maintainer",
      "impact": "采购门禁和锁定"
    },
    {
      "object": "MaterialSelection",
      "field": "content/selectionJson",
      "label": "选材文本/快照",
      "meaning": "颜色、规格、品牌、工艺、备注",
      "owner": "现场维护人",
      "impact": "不自动改报价/合同/成本"
    },
    {
      "object": "MaterialOrderSheet",
      "field": "sheetType",
      "label": "品类",
      "meaning": "一个品类一张单",
      "owner": "template/system",
      "impact": "决定模板字段、行骨架和打印"
    },
    {
      "object": "MaterialSheetTemplate",
      "field": "publishedVersion/version/fieldConfig",
      "label": "模板发布版本/版本/字段配置",
      "meaning": "企业已发布版本优先，否则企业最新版本，最后回退平台基线；作业单记录 templateVersion",
      "owner": "boss/storeManager",
      "impact": "决定 header/line 字段显隐、必填、顺序；企业不能改事实与权限红线",
      "sources": [
        "OBJ-008",
        "BR-044"
      ]
    },
    {
      "object": "MaterialSheetTemplate",
      "field": "headerFields/lineFields",
      "label": "单据头/行字段投影",
      "meaning": "material/sheet/enums 返回当前企业生效字段，前端按此渲染",
      "owner": "system",
      "impact": "避免前端硬编码品类字段；V1 仅平台基线 Tile 可用",
      "sources": [
        "OBJ-008",
        "BR-044",
        "97d5705"
      ]
    },
    {
      "object": "MaterialOrderSheet",
      "field": "measureAt/groupChatAt/deliverAt/installAt",
      "label": "测量/拉群/配送/安装日期",
      "meaning": "现场测量和计划时间",
      "owner": "designer/pm/boss",
      "impact": "测量是复尺依据；配送可带入要求到场；不是系统时间戳"
    },
    {
      "object": "MaterialOrderSheet",
      "field": "status/remark",
      "label": "作业单状态/取消原因",
      "meaning": "未进入采购前可取消为 Cancelled；取消原因追加到备注",
      "owner": "designer/boss/storeManager/finance（按现有操作权限）",
      "impact": "已下单、到场、结算后禁止直接取消，必须走采购调整或退货",
      "sources": [
        "OBJ-008",
        "DEC-MP-02",
        "97d5705"
      ]
    },
    {
      "object": "MaterialOrderSheet",
      "field": "priceState",
      "label": "价格状态",
      "meaning": "Unpriced/Priced/Settled",
      "owner": "system",
      "impact": "无价不阻断履约，但成本可能不完整"
    },
    {
      "object": "MaterialOrderSheetItem",
      "field": "materialPlan",
      "label": "行来源计划",
      "meaning": "作业单行必须挂 MaterialPlan",
      "owner": "system",
      "impact": "选材门禁和数量上限的唯一来源"
    },
    {
      "object": "MaterialOrderSheetItem",
      "field": "locationName",
      "label": "安装位置",
      "meaning": "客厅地砖、卫生间墙砖等",
      "owner": "designer/pm",
      "impact": "供厂家生产、测量和安装"
    },
    {
      "object": "MaterialOrderSheetItem",
      "field": "quoteCostPrice",
      "label": "报价成本价快照",
      "meaning": "P1，用于预计成本对照",
      "owner": "quote/contract",
      "impact": "只读，不进入实际成本"
    },
    {
      "object": "PurchaseOrder",
      "field": "supplier",
      "label": "供应商/经销商",
      "meaning": "实际供货合作方",
      "owner": "finance/boss/storeManager",
      "impact": "无供应商不能形成应付"
    },
    {
      "object": "PurchaseOrder",
      "field": "quantity/unitPrice/amount",
      "label": "采购数量/单价/金额",
      "meaning": "P2 采购事实",
      "owner": "finance/purchase",
      "impact": "形成应付和暂估成本"
    },
    {
      "object": "PurchaseOrder",
      "field": "priceState",
      "label": "价格状态",
      "meaning": "Priced/Unpriced/Settled/Mixed",
      "owner": "purchase/settlement",
      "impact": "无价形成暂估应付"
    },
    {
      "object": "PurchaseOrder",
      "field": "expectedAt/orderedAt",
      "label": "要求到场/下单日期",
      "meaning": "计划到场和实际下单日",
      "owner": "finance/purchase",
      "impact": "expectedAt 默认取 deliverAt；月结按 orderedAt 月份"
    },
    {
      "object": "GoodsReceipt",
      "field": "quantity/arrivedAt",
      "label": "到场数量/日期",
      "meaning": "实际到场事实",
      "owner": "pm/designer",
      "impact": "累计实际成本并回填账期"
    },
    {
      "object": "GoodsReceipt",
      "field": "inspector/images/remark",
      "label": "验收人/证据/异常",
      "meaning": "现场确认责任和证据",
      "owner": "pm/designer",
      "impact": "追溯、退货和供应商协商"
    },
    {
      "object": "Payable",
      "field": "estimated/settledAmount/dueDate",
      "label": "暂估/结算金额/到期日",
      "meaning": "应付状态和账期",

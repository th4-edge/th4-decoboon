  "rules": [
    {
      "id": "UOV-R01",
      "statement": "同一 quoteId + version 必须来自同一组原始行，并生成 REGION/TYPE 两套服务端投影。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R02",
      "statement": "TYPE 固定 ItemType → Category；目录项使用 catalogItemId 强身份，自定义行使用完整业务描述。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R03",
      "statement": "TYPE 合并且仅合并业务身份和商业条件完全相同的行；数量和金额按原始行权威值求和。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R04",
      "statement": "场景白名单只裁剪字段、动作和密度，不改变分组、行数、金额和数据范围。",
      "sourceRefs": [
        "DEC-086",
        "BR-052",
        "BR-003"
      ]
    },
    {
      "id": "UOV-R05",
      "statement": "合同和项目只使用实际绑定报价版本，禁止用最新报价替代签约依据。",
      "sourceRefs": [
        "DEC-086",
        "BR-002",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R06",
      "statement": "直接签约不新增来源标记、不做统计隔离；只显示真实关系可证明的无设计方案来源/签约报价基线。",
      "sourceRefs": [
        "DEC-071",
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R07",
      "statement": "在跑承接显示项目承接（接管基线），并由 BusinessOrigin.Carryover 排除正常首轮指标。",
      "sourceRefs": [
        "DEC-011",
        "BR-010",
        "DEC-086"
      ]
    },
    {
      "id": "UOV-R08",
      "statement": "项目 PHASE 节点按业务时间、记录时间、事实类型、对象 ID 稳定排序；历史/失效折叠保留。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-R09",
      "statement": "PDF 绑定 quoteId + version + groupMode；旧归档不覆盖；客户版不含成本、内部公式和供应商价。",
      "sourceRefs": [
        "DEC-086",
        "BR-052",
        "BR-003"
      ]
    }
  ],
  "checks": [
    {
      "id": "UOV-C01",
      "check": "REGION 与 TYPE 的源行集合一致，区域小计和类型小计可由原始行金额解释。",
      "sourceRefs": [
        "BR-052"
      ]
    },
    {
      "id": "UOV-C02",
      "check": "合并键任一字段不同不得合并；单位不同、单价不同、差异状态不同必须拆行。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-C03",
      "check": "前端不得自行合并、重算或接口失败回退分组。",
      "sourceRefs": [
        "BR-052",
        "GAP-065"
      ]
    },
    {
      "id": "UOV-C04",
      "check": "业主投影不得返回成本、成本完整性明细、内部公式、供应商执行价和 acceptedBy。",
      "sourceRefs": [
        "BR-003",
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-C05",
      "check": "合同量房摘要只取最近一次已完成量房；无记录和读取失败必须区分。",
      "sourceRefs": [
        "BR-052",
        "OBJ-007"
      ]
    },
    {
      "id": "UOV-C06",
      "check": "直接签约不得新增来源字段或修改接受率；承接必须排除正常首轮指标。",
      "sourceRefs": [
        "DEC-071",
        "DEC-011",
        "BR-010",
        "DEC-086"
      ]
    },
    {
      "id": "UOV-C07",
      "check": "项目 PHASE 顺序、节点时间、历史折叠和返回锚点稳定。",
      "sourceRefs": [
        "BR-052"
      ]
    },
    {
      "id": "UOV-C08",
      "check": "PDF 文件名和页眉可识别版本与分组，旧归档文件哈希不变。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-C09",
      "check": "跨企业、跨门店、跨项目、伪造 quoteId/version/groupMode 全部 403/404。",
      "sourceRefs": [
        "BR-001",
        "BR-052"
      ]
    }
  ],
  "exceptions": [
    {
      "id": "UOV-E01",
      "condition": "区域为空",
      "behavior": "统一进入综合项目，不隐藏行、不猜区域。",
      "sourceRefs": [
        "GAP-053",
        "DEC-086"
      ]
    },
    {
      "id": "UOV-E02",
      "condition": "原始行金额缺失",
      "behavior": "显示暂不可确认，禁止用 price × quantity 静默补齐。",
      "sourceRefs": [
        "DEC-086",
        "BR-052"
      ]
    },
    {
      "id": "UOV-E03",
      "condition": "无设计方案来源",
      "behavior": "显示关系可证明的无设计方案来源/签约报价基线；不得断言客户一定为直接签约。",
      "sourceRefs": [
        "DEC-071",
        "DEC-086"
      ]
    },
    {
      "id": "UOV-E04",
      "condition": "在跑项目承接",
      "behavior": "显示项目承接（接管基线）；成本完整性未知时利润为空。",
      "sourceRefs": [
        "DEC-011",
        "BR-010",
        "BR-003"
      ]
    },
    {
      "id": "UOV-E05",
      "condition": "部分读取失败",
      "behavior": "显示暂不可确认/部分事实暂不可确认，保留重试与返回路径。",
      "sourceRefs": [
        "BR-052",
        "BR-029"
      ]
    },
    {
      "id": "UOV-E06",
      "condition": "版本不匹配",
      "behavior": "阻断生成和跳转，不得自动切换最新版本。",
      "sourceRefs": [
        "DEC-086",
        "BR-002"
      ]
    }
  ],
  "metrics": [
    {
      "id": "UOV-M01",
      "name": "跨端报价事实一致率",
      "scope": "同一 quoteId + version 的销售字段、行来源、版本、状态和总额",
      "formula": "一致检查项通过数 / 检查项总数",
      "missing": "任一入口读取失败记为不可确认，不计为通过",
      "sourceRefs": [
        "BR-052",
        "DEC-086"
      ]
    },
    {
      "id": "UOV-M02",
      "name": "TYPE 来源回溯完整率",
      "scope": "TYPE 合并行",
      "formula": "可追回全部 sourceLineIds 的合并行数 / 合并行总数",
      "missing": "来源缺失必须阻断该合并行",
      "sourceRefs": [
        "BR-052",
        "DEC-086"
      ]
    }
  ],
